[
  {
    "type": "function",
    "function": {
      "name": "run_shell",
      "description": "在本地工作目录中执行一条 Shell 命令，并返回标准输出、标准错误和退出码。执行前会请求用户批准。",
      "parameters": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string",
            "description": "要执行的 Shell 命令。"
          },
          "timeout": {
            "type": "number",
            "description": "超时时间（秒），默认 30 秒，最大 300 秒。",
            "minimum": 0.1,
            "maximum": 300
          }
        },
        "required": ["command"],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "read_file",
      "description": "读取工作目录中某个文件的指定行范围，返回带行号的内容。",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "相对于工作目录的文件路径。"
          },
          "start_line": {
            "type": "integer",
            "description": "起始行号，从 1 开始，默认 1。",
            "minimum": 1
          },
          "end_line": {
            "type": "integer",
            "description": "结束行号（包含），省略时读到文件末尾。",
            "minimum": 1
          }
        },
        "required": ["path"],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "write_file",
      "description": "向工作目录中的文件写入完整内容，会覆盖原文件并自动创建父目录。执行前会请求用户批准。",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "相对于工作目录的文件路径。"
          },
          "content": {
            "type": "string",
            "description": "要写入的完整文件内容。"
          }
        },
        "required": ["path", "content"],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "list_files",
      "description": "列出工作目录中某个路径下的文件和子目录。",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "相对于工作目录的目录路径，默认当前目录。"
          },
          "recursive": {
            "type": "boolean",
            "description": "是否递归列出子目录，默认 false。"
          },
          "max_depth": {
            "type": "integer",
            "description": "递归时的最大深度，默认 2，最大 10。",
            "minimum": 1,
            "maximum": 10
          }
        },
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "search_text",
      "description": "在工作目录的文件中按正则表达式搜索文本，返回匹配的文件、行号和内容。",
      "parameters": {
        "type": "object",
        "properties": {
          "pattern": {
            "type": "string",
            "description": "要搜索的正则表达式。"
          },
          "path": {
            "type": "string",
            "description": "相对于工作目录的搜索起点，默认当前目录。"
          },
          "file_glob": {
            "type": "string",
            "description": "只搜索匹配该通配符的文件，例如 '*.c'，默认 '*'。"
          },
          "case_sensitive": {
            "type": "boolean",
            "description": "是否区分大小写，默认 false。"
          },
          "max_results": {
            "type": "integer",
            "description": "最多返回多少条结果，默认 100，最大 200。",
            "minimum": 1,
            "maximum": 200
          }
        },
        "required": ["pattern"],
        "additionalProperties": false
      }
    }
  }
]
